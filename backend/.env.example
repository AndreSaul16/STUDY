# OpenAI API Key — obtén tu key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Configuración del modelo (opcional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Esfuerzo de razonamiento. Modelos de razonamiento (gpt-5.x, o-series) REQUIEREN
# "none" para usar function tools en chat/completions. Déjalo VACÍO para modelos
# clásicos (gpt-4o-mini) que no aceptan este parámetro.
OPENAI_REASONING_EFFORT=none

# Configuración del MCP (opcional) — ruta al ejecutable jw-mcp
JW_MCP_PATH=jw-mcp
