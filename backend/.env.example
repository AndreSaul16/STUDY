# OpenAI API Key — obtén tu key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Configuración del modelo (opcional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Esfuerzo de razonamiento de la RESPUESTA FINAL del chat.
# Valores admitidos: none | low | medium | high | xhigh. Cualquier otro (p. ej.
# "max") lo rechaza la API con 400; el backend lo detecta y degrada a "none"
# en vez de dejar el chat caído, pero conviene poner uno válido.
# Las rondas con herramientas van SIEMPRE con "none": la API no admite
# reasoning_effort junto a `tools` en /v1/chat/completions.
# Déjalo VACÍO para modelos clásicos (gpt-4o-mini), que no aceptan el parámetro.
OPENAI_REASONING_EFFORT=high

# ─── Calidad de la investigación del chat ────────────────────────
# Todas son opcionales: si faltan o traen basura, se usa el default.

# Rondas máximas de tool-calling antes de forzar la respuesta final.
# Más rondas = respuestas mejor documentadas pero más lentas y más caras.
# Rango admitido: 1-10. Default: 5.
CHAT_MAX_TOOL_ROUNDS=5

# Segundos de investigación antes de cortar y redactar con lo que ya se tenga.
# Existe porque un scrape lento encadenado puede pasar de 60 s y los proxies
# (Railway) cortan el SSE por inactividad. Rango: 10-600. Default: 75.
CHAT_RESEARCH_BUDGET_SECONDS=75

# ¿Generar las 3 sugerencias de continuación con una llamada corta extra?
# Cuesta ~200 tokens por turno. Con 0 se usan las sugerencias estáticas de
# cada modo. Default: 1.
CHAT_FOLLOWUPS=1

# Configuración del MCP (opcional) — ruta al ejecutable jw-mcp
JW_MCP_PATH=jw-mcp
