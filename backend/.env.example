# OpenAI API Key — obtén tu key en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Configuración del modelo (opcional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Esfuerzo de razonamiento de la RESPUESTA FINAL del chat.
# Valores admitidos: none | low | medium | high | xhigh. Cualquier otro (p. ej.
# "max") lo rechaza la API con 400; el backend lo detecta y degrada a "none"
# en vez de dejar el chat caído, pero conviene poner uno válido.
# Las rondas con herramientas van SIEMPRE con "none": la API no admite
# reasoning_effort junto a `tools` en /v1/chat/completions.
# Déjalo VACÍO para modelos clásicos (gpt-4o-mini), que no aceptan el parámetro.
OPENAI_REASONING_EFFORT=high

# ─── Calidad de la investigación del chat ────────────────────────
# Todas son opcionales: si faltan o traen basura, se usa el default.

# Rondas máximas de tool-calling antes de forzar la respuesta final.
# Más rondas = respuestas mejor documentadas pero más lentas y más caras.
# Rango admitido: 1-10. Default: 5.
CHAT_MAX_TOOL_ROUNDS=5

# Segundos de investigación antes de cortar y redactar con lo que ya se tenga.
# Existe porque un scrape lento encadenado puede pasar de 60 s y los proxies
# (Railway) cortan el SSE por inactividad. Rango: 10-600. Default: 75.
CHAT_RESEARCH_BUDGET_SECONDS=75

# ¿Generar las 3 sugerencias de continuación con una llamada corta extra?
# Cuesta ~200 tokens por turno. Con 0 se usan las sugerencias estáticas de
# cada modo. Default: 1.
CHAT_FOLLOWUPS=1

# Configuración del MCP (opcional) — ruta al ejecutable jw-mcp
JW_MCP_PATH=jw-mcp

# ─── Proveedores de IA y BYOK ────────────────────────────────────
# A partir de esta versión, OPENAI_* es el "MODO SERVIDOR": la configuración
# de reserva que se usa cuando el usuario NO trae su propia API key. Con key
# de cliente (cabecera X-AI-Api-Key) manda esa y estas variables no se tocan.

# Proveedor del modo servidor: openai | google. Default: openai.
# Con google, la key se lee de GOOGLE_API_KEY o GEMINI_API_KEY.
CHAT_PROVIDER=openai

# Key del modo servidor si CHAT_PROVIDER=google.
# GOOGLE_API_KEY=

# ¿Exigir que cada usuario traiga su propia key?
# La URL de Railway es pública y sin autenticación: con 0, cualquiera que la
# abra gasta la key del dueño. Ponlo a 1 en producción. Default: 0.
CHAT_REQUIRE_CLIENT_KEY=0

# ¿Puede el cliente elegir modelo y esfuerzo también en modo servidor?
# Con 0 se ignoran los campos `model` y `effort` del cuerpo y manda
# OPENAI_MODEL. Default: 1.
CHAT_ALLOW_CLIENT_MODEL=1

# ─── Investigación profunda (modo `investigacion`) ───────────────
# Un informe encadena muchas más consultas que un turno normal. Todas son
# opcionales: basura o fuera de rango degrada al default.

# Rondas de herramientas de TODA la investigación. Rango 4-30. Default: 14.
RESEARCH_MAX_TOOL_ROUNDS=14

# Segundos de investigación antes de cortar y redactar. Rango 60-1800.
# Default: 300.
RESEARCH_BUDGET_SECONDS=300

# Documentos distintos que se abren como máximo. Rango 3-30. Default: 12.
RESEARCH_MAX_DOCS=12

# Cuánto sobrevive un informe terminado en memoria antes de purgarse, para
# que el cliente pueda reengancharse. Rango 300-21600. Default: 3600.
RESEARCH_JOB_TTL_SECONDS=3600

# Investigaciones vivas a la vez. Cada una son minutos de CPU y dinero.
# Rango 1-16. Default: 4.
RESEARCH_MAX_LIVE_JOBS=4

# Proveedor del deep research delegado. HOY SOLO VALE "propio": la fase que
# delegaría en o3-deep-research está documentada pero NO implementada, porque
# verificarla exige una prueba de pago. Google queda descartado de raíz: no
# permite restringir la búsqueda a wol.jw.org.
DEEP_RESEARCH_PROVIDER=propio
